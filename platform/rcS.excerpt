${INITDIR}/mountfs start
${INITDIR}/timezone check
${INITDIR}/hostname start
${INITDIR}/syslog start
${INITDIR}/watchdog start
#${INITDIR}/nlmetrics start
${INITDIR}/orderly_reboot start
${INITDIR}/dbus start
#${INITDIR}/heartbeat start
#${INITDIR}/nlsleep start
#${INITDIR}/nlshutdown start
(setsid /media/scratch/.nest_gen2_sdk/entropyd /media/scratch/.nest_gen2_sdk/random-seed > /dev/null 2>&1 </dev/null &)
${INITDIR}/networking start
(setsid /media/scratch/.nest_gen2_sdk/wifi.sh takeover > /dev/null 2>&1 </dev/null &)
${INITDIR}/sshd start
#${INITDIR}/nestlabs start
#${INITDIR}/monit start
/bin/dropbear -g
(setsid /media/scratch/.nest_gen2_sdk/app_watchdog.sh foxbus > /media/scratch/.nest_gen2_sdk/app_watchdog_stdout.log 2>&1 </dev/null &)
${INITDIR}/nleapi start
